{
  "name": "dotpath-navigator",
  "displayName": "Dotpath Navigator",
  "description": "Quickly jump to nested object paths (JSON/TS), resolve computed keys, and even create missing branches.",
  "version": "0.0.10",
  "engines": {
    "vscode": "^1.75.0"
  },
  "publisher": "TiagoVentura",
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:dotpathNavigator.search"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dotpathNavigator.search",
        "title": "Dotpath Navigator: Search"
      },
      {
        "command": "dotpathNavigator.getDotPathAtCursor",
        "title": "Dotpath Navigator: Get Path at Cursor"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Dotpath Navigator",
      "properties": {
        "dotpathNavigator.extraFiles": {
          "type": "array",
          "description": "Glob patterns of additional files to include in searches (e.g. translation JSONs).",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "keybindings": [
      {
        "command": "dotpathNavigator.search",
        "key": "ctrl+alt+o",
        "when": "editorTextFocus"
      },
      {
        "command": "dotpathNavigator.getDotPathAtCursor",
        "key": "ctrl+alt+p",
        "when": "editorTextFocus"
      }
    ]
  },
  "repository": {
    "url": "https://github.com/TamVentura/vscode-dotpath-navigator",
    "type": "git"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "package": "(mkdir vsix_output 2> NUL) & vsce package --out \"vsix_output/\""
  },
  "devDependencies": {
    "@types/node": "^16.11.7",
    "@types/vscode": "^1.43.2",
    "typescript": "^4.8.4"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "ts-morph": "^17.0.0",
    "vsce": "^2.15.0"
  }
}